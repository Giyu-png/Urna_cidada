<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Log geral da sua aplicação -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Silencia o "barulho" do gRPC/Firestore em produção -->
    <logger name="io.grpc" level="WARN"/>
    <logger name="io.grpc.netty" level="ERROR"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.google.cloud.firestore" level="INFO"/>
    <logger name="com.google.api.gax" level="WARN"/>
</configuration>